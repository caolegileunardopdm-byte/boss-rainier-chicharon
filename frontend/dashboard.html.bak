<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - Boss Rainier Chicharon</title>
    <link rel="stylesheet" href="../css/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <a href="../index.html" class="navbar-brand">🥓 Boss Rainier Chicharon</a>
      <ul class="navbar-nav">
        <li><a href="dashboard.html">Dashboard</a></li>
        <li><a href="products.html">Products</a></li>
        <li><a href="orders.html">Orders</a></li>
        <li><a href="inventory.html">Inventory</a></li>
        <li>
          <a
            href="#"
            onclick="
              logout();
              return false;
            "
            >Logout</a
          >
        </li>
      </ul>
    </nav>

    <div class="container">
      <h1 style="color: var(--primary)">Admin Dashboard</h1>
      <p style="color: var(--text-light); margin-bottom: 2rem">
        Welcome, Admin!
      </p>

      <div id="stats" class="grid grid-3">
        <div class="loading">
          <div class="spinner"></div>
          <p>Loading stats...</p>
        </div>
      </div>
    </div>

    <footer class="footer">
      <p>© 2026 Boss Rainier Chicharon. All rights reserved.</p>
    </footer>

    <script src="../js/config.js"></script>
    <script>
      // Check if admin
      if (!isLoggedIn() || !isAdmin()) {
        alert("Admin access only!");
        window.location.href = "../login.html";
      }

      async function loadStats() {
        const [products, orders, users, inventory] = await Promise.all([
          apiCall("/products"),
          apiCall("/orders"),
          apiCall("/users"),
          apiCall("/inventory"),
        ]);

        const stats = [
          {
            label: "Products",
            value: products.data?.length || 0,
            color: "#3b82f6",
          },
          {
            label: "Orders",
            value: orders.data?.length || 0,
            color: "#10b981",
          },
          { label: "Users", value: users.data?.length || 0, color: "#f59e0b" },
          {
            label: "Inventory Items",
            value: inventory.data?.length || 0,
            color: "#8b5cf6",
          },
        ];

        document.getElementById("stats").innerHTML = stats
          .map(
            (s) => `
        <div class="card" style="text-align: center;">
          <h2 style="font-size: 3rem; color: ${s.color}; margin-bottom: 0.5rem;">${s.value}</h2>
          <p style="color: var(--text-light); font-size: 1.1rem;">${s.label}</p>
        </div>
      `,
          )
          .join("");
      }

      loadStats();
    </script>
  </body>
</html>
